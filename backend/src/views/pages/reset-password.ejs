<div class="auth-wrapper">

    <div class="auth-card">

        <h2 class="page-title">
            Reset New Password
        </h2>

        <form
            class="form-grid"
            id="resetForm"
        >

            <!-- New Password -->
            <div class="form-row">

                <label>
                    New Password
                </label>

                <div class="input-action">

                    <input
                        id="newPassword"
                        type="password"
                        name="newPassword"
                        required
                    >

                    <button
                        class="btn btn-secondary"
                        type="button"
                        data-toggle="newPassword"
                    >
                        Show
                    </button>

                </div>

            </div>

            <!-- Confirm New Password -->
            <div class="form-row">

                <label>
                    Confirm New Password
                </label>

                <div class="input-action">

                    <input
                        id="confirmPassword"
                        type="password"
                        name="confirmPassword"
                        required
                    >

                    <button
                        class="btn btn-secondary"
                        type="button"
                        data-toggle="confirmPassword"
                    >
                        Show
                    </button>

                </div>

            </div>

            <!-- Password Rules -->
            <div class="detail-card">

                <strong>
                    Password Rules:
                </strong>

                <ul>

                    <li>
                        8 to 16 characters
                    </li>

                    <li>
                        Must start with a capital letter
                    </li>

                    <li>
                        Only letters, numbers and @ # $ % &
                    </li>

                    <li>
                        1 to 3 special characters from @ # $ % &
                    </li>

                </ul>

            </div>

            <!-- Error Message -->
            <p
                id="resetError"
                class="error-text"
            ></p>

            <!-- Success Message -->
            <p
                id="resetMessage"
                class="success-text"
            ></p>

            <!-- Reset Button -->
            <button
                class="btn btn-primary"
                type="submit"
            >
                Reset Password
            </button>

        </form>

        <!-- Login Link -->
        <div class="mt muted">

            Back to

            <a
                class="text-link"
                href="/login"
            >
                Login
            </a>

        </div>

    </div>

</div>

<!-- Get Reset Token From URL -->
<script>

    const pathParts =
        window.location.pathname.split("/");

    window.RESET_TOKEN =
        pathParts[pathParts.length - 1];

</script>

<!-- Main JavaScript -->
<script src="/js/app.js"></script>