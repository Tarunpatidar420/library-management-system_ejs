<div class="page-card">

    <h2 class="page-title">
        Update Book / Movie
    </h2>

    <div class="form-grid">

        <!-- Select Item -->
        <div class="form-row">

            <label>
                Select Item
            </label>

            <select id="updateItemSelect">

                <option value="">
                    Select
                </option>

            </select>

        </div>

        <!-- Update Form -->
        <form
            id="updateItemForm"
            class="form-grid hidden"
        >

            <!-- Type -->
            <div class="form-row">

                <label>
                    Type
                </label>

                <select name="itemType">

                    <option value="book">
                        Book
                    </option>

                    <option value="movie">
                        Movie
                    </option>

                </select>

            </div>

            <!-- Title -->
            <div class="form-row">

                <label>
                    Title
                </label>

                <input
                    name="title"
                >

            </div>

            <!-- Author -->
            <div class="form-row">

                <label>
                    Author
                </label>

                <input
                    name="author"
                >

            </div>

            <!-- Category -->
            <div class="form-row">

                <label>
                    Category
                </label>

                <input
                    name="category"
                >

            </div>

            <!-- Serial Number -->
            <div class="form-row">

                <label>
                    Serial Number
                </label>

                <input
                    name="serialNumber"
                >

            </div>

            <!-- Status -->
            <div class="form-row">

                <label>
                    Status
                </label>

                <select name="status">

                    <option value="active">
                        Active
                    </option>

                    <option value="inactive">
                        Inactive
                    </option>

                </select>

            </div>

            <!-- Success Message -->
            <p
                id="updateItemMessage"
                class="success-text"
            ></p>

            <!-- Error Message -->
            <p
                id="updateItemError"
                class="error-text"
            ></p>

            <!-- Update Button -->
            <button
                class="btn btn-primary"
            >
                Update Item
            </button>

        </form>

    </div>

</div>