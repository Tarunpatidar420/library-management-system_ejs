<div class="auth-wrapper">

    <div class="auth-card">

        <h2 class="page-title">
            Login
        </h2>

        <form
            class="form-grid"
            id="loginForm"
        >

            <!-- Email -->
            <div class="form-row">

                <label>
                    Email
                </label>

                <input
                    type="email"
                    name="email"
                    placeholder="Enter email"
                    required
                >

            </div>

            <!-- Password -->
            <div class="form-row">

                <label>
                    Password
                </label>

                <div class="input-action">

                    <input
                        id="loginPassword"
                        type="password"
                        name="password"
                        placeholder="Enter password"
                        required
                    >

                    <button
                        class="btn btn-secondary"
                        type="button"
                        data-toggle="loginPassword"
                    >
                        Show
                    </button>

                </div>

            </div>

            <!-- Admin Pass Key -->
            <div
                class="form-row hidden"
                id="adminKeyRow"
            >

                <label>
                    Admin Pass Key
                </label>

                <div class="input-action">

                    <input
                        id="adminPassKey"
                        type="password"
                        name="adminPassKey"
                        placeholder="Enter admin pass key"
                    >

                    <button
                        class="btn btn-secondary"
                        type="button"
                        data-toggle="adminPassKey"
                    >
                        Show
                    </button>

                </div>

            </div>

            <!-- Error -->
            <p
                id="loginError"
                class="error-text"
            ></p>

            <!-- Login Button -->
            <button
                class="btn btn-primary"
                type="submit"
            >
                Login
            </button>

        </form>

        <!-- Links -->
        <div class="mt muted">

            <p>
                Don't have an account?

                <a
                    class="text-link"
                    href="/register"
                >
                    Register
                </a>
            </p>

            <p class="mt-small">

                Forgot password?

                <a
                    class="text-link"
                    href="/forgot-password"
                >
                    Reset here
                </a>

            </p>

        </div>

    </div>

</div>