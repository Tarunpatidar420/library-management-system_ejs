<div class="auth-wrapper">

    <div class="auth-card">

        <h2 class="page-title">
            Forgot Password
        </h2>

        <form
            class="form-grid"
            id="forgotForm"
        >

            <div class="form-row">

                <label>
                    Registered Email
                </label>

                <input
                    type="email"
                    name="email"
                    placeholder="Enter registered email"
                    required
                >

            </div>

            <p
                id="forgotError"
                class="error-text"
            ></p>

            <p
                id="forgotMessage"
                class="success-text"
            ></p>

            <button
                class="btn btn-primary"
                type="submit"
            >
                Send Reset Link
            </button>

        </form>

        <div class="mt muted">

            Back to

            <a
                class="text-link"
                href="/login"
            >
                Login
            </a>

        </div>

    </div>

</div>