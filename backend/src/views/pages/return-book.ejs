<div class="page-card">
    <h2 class="page-title">Return Book</h2>
    <form class="form-grid" id="returnBookForm">
    <div class="form-row">
        <label>Serial Number</label>
        <input name="serialNumber">
    </div>
    <div class="form-row">
        <label>Actual Return Date</label>
        <input type="date" name="actualReturnDate">
    </div>
    <div class="form-row">
        <label>Remarks</label>
        <textarea name="remarks"></textarea>
    </div>
    <p id="returnError" class="error-text"></p>
    <button class="btn btn-primary">Confirm Return</button>
</form>
</div>
